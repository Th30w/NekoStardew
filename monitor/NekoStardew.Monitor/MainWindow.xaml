<Window x:Class="NekoStardew.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星露谷 · 后台实况"
        Height="760" Width="1220"
        Background="#F4F4F1"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="316" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="CaptionText"
                   Text="实时画面" Foreground="#4A4A46" VerticalAlignment="Center" />

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#B0B0AB" BorderThickness="1" Background="#1C1C1C">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform" SnapsToDevicePixels="True" />
                <TextBlock x:Name="PlaceholderText" Text="等待星露谷窗口"
                           Foreground="#8A8A86" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                Margin="12,0,0,0" BorderBrush="#B0B0AB" BorderThickness="1" Background="#FBFBF9">
            <DockPanel Margin="10">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="运行状态" FontWeight="SemiBold" Foreground="#2B2B28" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="插件" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PluginLinkText" Text="未连接" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModLinkText" Text="未连接" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="托管" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModeText" Text="--" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="画面" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FrameText" Text="0 帧/秒" />
                    </Grid>

                    <Rectangle Height="1" Fill="#DEDED8" Margin="0,10" />

                    <TextBlock Text="农场" FontWeight="SemiBold" Foreground="#2B2B28" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="日期" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DateText" Text="--" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="时间" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TimeText" Text="--" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="天气" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="WeatherText" Text="--" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="金钱" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MoneyText" Text="--" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="体力" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StaminaText" Text="--" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="位置" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LocationText" Text="--" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="作物" Foreground="#6E6E6A" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="CropText" Text="--" />
                    </Grid>

                    <Rectangle Height="1" Fill="#DEDED8" Margin="0,10" />

                    <TextBlock Text="当前任务" FontWeight="SemiBold" Foreground="#2B2B28" />
                    <TextBlock x:Name="GoalText" Text="空闲" TextWrapping="Wrap"
                               Margin="0,6,0,0" Foreground="#3A3A36" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="日志" FontWeight="SemiBold"
                           Foreground="#2B2B28" Margin="0,12,0,4" />

                <Border BorderBrush="#DEDED8" BorderThickness="1" Background="#FFFFFF">
                    <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
